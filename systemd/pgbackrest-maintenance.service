[Unit]
Description=pgBackRest maintenance (expire + check)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=__DEPLOY_DIR__
EnvironmentFile=__DEPLOY_DIR__/env/.env.compose
EnvironmentFile=__DEPLOY_DIR__/env/.env.backup
ExecStart=__SCRIPT_DST_DIR__/pgbackrest-maintenance.sh
