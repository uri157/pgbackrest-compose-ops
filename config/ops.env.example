# Copy this file to config/ops.env and adjust for your host.
# Scripts load this file automatically when present.
#
# Optional: override path with:
#   export PGBR_OPS_CONFIG=/absolute/path/to/ops.env

DEPLOY_DIR=/opt/pgbackrest-compose-ops
COMPOSE_FILE=${DEPLOY_DIR}/docker-compose.prod.yml
ENV_DIR=${DEPLOY_DIR}/env
COMPOSE_ENV=${ENV_DIR}/.env.compose
DEPLOY_ENV=${DEPLOY_DIR}/.env.deploy
STATE_DIR=${DEPLOY_DIR}/state

PG_SERVICE=postgres
PGBACKREST_SERVICE=pgbackrest

# pgBackRest settings
PGBR_STANZA=main
PGBR_CONFIG=/etc/pgbackrest/pgbackrest.conf

# Naming defaults for shadow restores
RESTORE_PROJECT_PREFIX=pgbackrest-restore-
RESTORE_VOLUME_PREFIX=pgrestore_
SHADOW_PATTERN=^pgbackrest-restore-
PROD_PROJECT_FALLBACK=pgbackrest-prod

# Volume listing filter used by postgres-list-volumes.sh
VOLUME_LIST_REGEX=postgres|pgbackrest|pgdata|restore

# Optional image hint used to inspect docker volume emptiness.
# Leave empty to auto-detect from common images.
PGBR_POSTGRES_IMAGE=
TEST_CONTAINER_PREFIX=pgbackrest-restore-test

# Services restarted by pitr-restore.sh when --cutover is used.
CUTOVER_SERVICES=postgres pgbackrest

# systemd installer defaults
SYSTEMD_UNIT_PREFIX=pgbackrest
UNIT_TEMPLATE_PREFIX=pgbackrest
UNIT_DST_DIR=/etc/systemd/system
SCRIPT_DST_DIR=${DEPLOY_DIR}/scripts
